# Lokal udvikling kører mod PGlite i .data/dev (single-process: stop dev-serveren
# før `npm run db:migrate` og `npm run db:seed`). Fjern linjen for at bruge DATABASE_URL.
PGLITE_DIR=.data/dev

# Supabase transaction pooler (port 6543). Bruges af appen på Vercel.
DATABASE_URL=
# Supabase session pooler (port 5432). Bruges kun af drizzle-kit migrate.
DATABASE_URL_UNPOOLED=

# HMAC-nøgle til admin-sessionen: `openssl rand -hex 32`
SESSION_SECRET=

# Google-login til admin
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Kommaseparerede e-mails med ejerrolle
ADMIN_OWNER_EMAILS=
# Origin, der håndterer Google-callback for previews (fx https://mapfact.com)
ADMIN_LOGIN_ORIGIN=
# Nødlogin med adgangskode (tom = slået fra)
ADMIN_PASSWORD=
# Bearer-token til scripts mod /api/admin
ADMIN_API_TOKEN=

# Vercel-cron sender `Authorization: Bearer $CRON_SECRET`
CRON_SECRET=
